{
  "meta": {
    "project": "FishingOffice",
    "version": "V1.0"
  },
  "home": {
    "meta": {
      "page": "Home",
      "version": "1.0"
    },
    "dialogs": {
      "ProfileDialog": {
        "type": "medium",
        "title": "我的资料",
        "description": "显示玩家头像、昵称、ID、等级、摸鱼币、积分。",
        "contentSource": "profile",
        "closeable": true
      },
      "ProfileCenterDialog": {
        "type": "full",
        "title": "个人中心",
        "description": "展示玩家成长记录、资产中心、我的资料、称号、成就统计和游戏设置。",
        "contentSource": "profileCenter",
        "closeable": true
      },
      "SettingsDialog": {
        "type": "full",
        "title": "设置中心",
        "description": "游戏体验设置，支持保存、恢复默认和清除缓存。",
        "contentSource": "settings",
        "closeable": true
      },
      "TransactionRecordsDialog": {
        "type": "full",
        "title": "交易记录",
        "description": "展示最近 10 条交易记录，支持分页切换，不允许滚动。",
        "contentSource": "transactionRecords",
        "closeable": true
      },
      "GameHelpDialog": {
        "type": "full",
        "title": "游戏说明",
        "description": "全屏游戏说明弹窗，左侧目录导航，右侧说明内容。",
        "contentSource": "guide",
        "closeable": true
      },
      "TaskDialog": {
        "type": "medium",
        "title": "今日快乐",
        "description": "展示今日任务，但不得制造 KPI 压迫感。",
        "contentSource": "tasks",
        "closeable": true
      },
      "StoreDialog": {
        "type": "full",
        "title": "渔具商店",
        "description": "木质货柜风格，展示鱼竿、鱼线、鱼漂、鱼饵、工具等商品。",
        "contentSource": "store",
        "closeable": true
      },
      "HonorDialog": {
        "type": "full",
        "title": "荣耀墙",
        "description": "展示玩家鱼获、成长记录、积分、等级和时间曲线。",
        "contentSource": "honor",
        "closeable": true
      },
      "BagDialog": {
        "type": "full",
        "title": "我的背包",
        "description": "展示玩家拥有的渔具、鱼饵、鱼漂、工具和鱼获。",
        "contentSource": "inventory",
        "closeable": true
      },
      "FishCollectionDialog": {
        "type": "full",
        "title": "海洋图鉴",
        "description": "展示玩家在第二世界中收集到的鱼类记录与探索足迹。",
        "contentSource": "fish_collection",
        "closeable": true
      },
      "ComputerDialog": {
        "type": "medium",
        "title": "工作电脑",
        "description": "展示正常办公内容，不应过度游戏化。",
        "contentSource": "computer",
        "closeable": true
      },
      "FishBucketDialog": {
        "type": "medium",
        "title": "鱼桶",
        "description": "展示当前暂存鱼获。",
        "contentSource": "fishBucket",
        "closeable": true
      },
      "ToolBoxDialog": {
        "type": "medium",
        "title": "工具盒",
        "description": "展示当前可用工具。",
        "contentSource": "toolBox",
        "closeable": true
      },
      "ExitDialog": {
        "type": "small",
        "title": "带着快乐回去吗？",
        "description": "退出确认弹窗，文案必须温和，不制造留存焦虑。",
        "contentSource": "exit",
        "closeable": true,
        "actions": [
          {
            "label": "再摸一会儿",
            "action": "closeDialog"
          },
          {
            "label": "带着快乐回去",
            "action": "exitGame"
          }
        ]
      }
    }
  },
  "store": {
    "meta": {
      "page": "Store",
      "version": "1.0"
    },
    "dialogs": {
      "ProductDetailDialog": {
        "type": "medium",
        "title": "商品详情",
        "description": "展示商品名称、类型、等级、价格、效果说明和拥有数量。",
        "contentSource": "selectedProduct",
        "closeable": true,
        "actions": [
          {
            "label": "取消",
            "action": "closeDialog"
          },
          {
            "label": "购买",
            "action": "openDialog",
            "target": "ConfirmPurchaseDialog"
          }
        ]
      },
      "ConfirmPurchaseDialog": {
        "type": "small",
        "title": "确认购买",
        "description": "确认是否使用摸鱼币购买该商品。",
        "contentSource": "selectedProductPurchase",
        "closeable": true,
        "actions": [
          {
            "label": "再看看",
            "action": "closeDialog"
          },
          {
            "label": "买一个",
            "action": "purchaseItem"
          }
        ]
      },
      "PurchaseSuccessDialog": {
        "type": "small",
        "title": "购买成功",
        "description": "商品已放入背包。",
        "contentSource": "purchaseResult",
        "closeable": true,
        "actions": [
          {
            "label": "知道了",
            "action": "closeDialog"
          }
        ]
      },
      "InsufficientCoinDialog": {
        "type": "small",
        "title": "摸鱼币不足",
        "description": "摸鱼币暂时不够，可以去钱包兑换，也可以继续钓鱼赚取。",
        "contentSource": "walletGuide",
        "closeable": true,
        "actions": [
          {
            "label": "继续看看",
            "action": "closeDialog"
          },
          {
            "label": "去钱包",
            "action": "navigate",
            "target": "/wallet"
          }
        ]
      }
    }
  }
}
