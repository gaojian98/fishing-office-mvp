{
  "meta": {
    "project": "FishingOffice",
    "version": "V1.0"
  },
  "home": {
    "meta": {
      "project": "FishingOffice",
      "page": "Home",
      "version": "V3.0"
    },
    "presets": {
      "button_tap": {
        "type": "scale",
        "from": 1,
        "to": 0.95,
        "durationMs": 150,
        "reverse": true
      },
      "dialog_open": {
        "type": "fadeScale",
        "durationMs": 180
      },
      "float_idle": {
        "type": "translateY",
        "from": -4,
        "to": 5,
        "durationMs": 1200,
        "loop": true,
        "yoyo": true
      },
      "fish_jump": {
        "type": "jump",
        "randomDelayMs": [
          1200,
          6000
        ],
        "loop": true
      }
    },
    "bindings": [
      {
        "target": "all_buttons",
        "on": "tap",
        "preset": "button_tap"
      },
      {
        "target": "fish_float",
        "on": "load",
        "preset": "float_idle"
      },
      {
        "target": "StoreDialog",
        "on": "open",
        "preset": "dialog_open"
      },
      {
        "target": "HonorDialog",
        "on": "open",
        "preset": "dialog_open"
      },
      {
        "target": "BagDialog",
        "on": "open",
        "preset": "dialog_open"
      }
    ]
  },
  "store": {
    "meta": {
      "page": "Store",
      "version": "1.0"
    },
    "animationPresets": {
      "dialogOpen": {
        "type": "fadeScale",
        "opacityFrom": 0,
        "opacityTo": 1,
        "scaleFrom": 0.96,
        "scaleTo": 1,
        "durationMs": 180,
        "curve": "easeOut"
      },
      "dialogClose": {
        "type": "fade",
        "opacityFrom": 1,
        "opacityTo": 0,
        "durationMs": 150,
        "curve": "easeIn"
      },
      "tabSwitch": {
        "type": "fade",
        "opacityFrom": 0.65,
        "opacityTo": 1,
        "durationMs": 120,
        "curve": "easeOut"
      },
      "productCardEnter": {
        "type": "fadeMoveUp",
        "opacityFrom": 0,
        "opacityTo": 1,
        "moveY": -8,
        "durationMs": 160,
        "curve": "easeOut"
      },
      "productCardPress": {
        "type": "scale",
        "from": 1,
        "to": 0.98,
        "durationMs": 120,
        "curve": "easeOut",
        "reverse": true
      },
      "purchaseSuccess": {
        "type": "fadeMoveUp",
        "opacityFrom": 0,
        "opacityTo": 1,
        "moveY": -16,
        "durationMs": 420,
        "curve": "easeOut"
      }
    },
    "bindings": [
      {
        "target": "StoreDialog",
        "event": "open",
        "preset": "dialogOpen"
      },
      {
        "target": "StoreDialog",
        "event": "close",
        "preset": "dialogClose"
      },
      {
        "target": "storeTabs",
        "event": "switch",
        "preset": "tabSwitch"
      },
      {
        "target": "productCard",
        "event": "enter",
        "preset": "productCardEnter"
      },
      {
        "target": "productCard",
        "event": "tap",
        "preset": "productCardPress"
      },
      {
        "target": "PurchaseSuccessDialog",
        "event": "open",
        "preset": "purchaseSuccess"
      }
    ],
    "rules": {
      "reduceMotion": {
        "disableProductEnterAnimation": true,
        "keepButtonFeedback": true,
        "keepDialogAnimation": true
      },
      "performance": {
        "targetFps": 60,
        "maxAnimatedCardsAtOnce": 12
      }
    }
  }
}